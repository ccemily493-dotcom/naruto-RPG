# FREE_ONLY_MODE: Enforces completely free architecture (only free/local GM providers allowed).
FREE_ONLY_MODE=true

# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini Pro & Flash free tier).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_PRO_MODEL & GEMINI_FLASH_MODEL configuration
GEMINI_PRO_MODEL="gemini-1.5-pro"
GEMINI_FLASH_MODEL="gemini-1.5-flash"

# QWEN_LOCAL_URL & QWEN_LOCAL_MODEL configuration (Ollama / LM Studio local endpoint)
QWEN_LOCAL_URL="http://localhost:11434/v1"
QWEN_LOCAL_MODEL="qwen2.5"

# OPENAI_API_KEY & OPENAI_MODEL: Fallback for OpenAI models if configured.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
